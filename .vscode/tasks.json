{
  // Cmd+Shift+B runs the default task: build Lab 2 and flash it to the Pico.
  // Other tasks: Cmd+Shift+P, then "Tasks: Run Task".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lab 2: build and flash",
      "type": "shell",
      "command": "./flash.sh Lab2_Galton",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}/Lab2_Galton"] }
    },
    {
      "label": "Lab 2: build only (check for errors)",
      "type": "shell",
      "command": "./build.sh Lab2_Galton",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": { "base": "$gcc", "fileLocation": ["autoDetect", "${workspaceFolder}/Lab2_Galton"] }
    },
    {
      "label": "Lab 1: build and flash",
      "type": "shell",
      "command": "./flash.sh Lab1_Birdsong",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
